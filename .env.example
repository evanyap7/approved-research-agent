# Recommended: free open-source inference on Groq (openai/gpt-oss-120b)
GROQ_API_KEY=gsk_your_groq_api_key

# Optional fallback model (gemini-3.6-flash), used when no Groq key is set
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Optional search providers. Without either, the app falls back to DuckDuckGo.
TAVILY_API_KEY=
SERPER_API_KEY=
